# Public base URL of the FastAPI backend. The browser hits this directly.
# In dev with the backend on localhost:8000, leave the default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Operations Console (/admin) auth bypass — DEVELOPMENT ONLY.
#   true  -> skip login, treat operator as authenticated
#   false -> enforce real backend JWT auth
#   unset -> bypass in development, enforce in production builds
# Never set this to "true" on a public/production deployment.
NEXT_PUBLIC_ADMIN_AUTH_DISABLED=true
# Optional display email while auth is bypassed.
NEXT_PUBLIC_ADMIN_DEV_EMAIL=dev@afrisale.local
